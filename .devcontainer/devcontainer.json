{
	"name": "Playwright testing devcontainer",
	// See https://mcr.microsoft.com/en-us/artifact/mar/devcontainers/javascript-node/
	"image": "mcr.microsoft.com/devcontainers/javascript-node",
	"runArgs": [
		"--init",
		"--shm-size=1g"
	],
	"postCreateCommand": "bash .devcontainer/postCreate.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-playwright.playwright"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/desktop-lite:1": {}
	},
	"forwardPorts": [
		// The port that the Desktop Lite feature uses to provide a web-based desktop environment
		6080
	]
}
